                mouseAimZ = 0;
            let isMouseDown = false;
            let isMobile = false;

            const joy = { active: false, tid: null, cx: 0, cy: 0, dx: 0, dy: 0, mag: 0 };
            let mFire = false,
                mBuild = false,
                mJump = false;
            let mobileShootOnce = false;

            const raycaster = new THREE.Raycaster();
            const aimPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);

            function screenToWorld(cx, cy) {
                raycaster.setFromCamera(
                    new THREE.Vector2((cx / window.innerWidth) * 2 - 1, -(cy / window.innerHeight) * 2 + 1),
                    camera
                );
                const hit = new THREE.Vector3();
                raycaster.ray.intersectPlane(aimPlane, hit);
                return hit;
            }

            // Keyboard
            document.addEventListener('keydown', e => {
                const k = e.key.toLowerCase();
                if (k === 'p' || k === 'escape') { if (gameState.running) togglePause(); return; }
                if (!gameState.running || gameState.paused) return;
                keys[k] = true;

                if (e.key === '1') { player.curWeapon = 0;
                    updateWeaponHUD(); }
                if (e.key === '2') { player.curWeapon = 1;
                    updateWeaponHUD(); }
                if (e.key === '3') { player.curWeapon = 2;
                    updateWeaponHUD(); }
                if (k === 'r') startReload();
                if (k === 'f') tryBuild();
                if (k === 'q') cycleBuildType();
                if (k === ' ' || k === 'space') {
                    e.preventDefault();
                    if (bus.active && !bus.done && !player.grounded && !player.gliding) {
                        jumpFromBus();
                    } else if (player.grounded) {
                        player.vy = 5.5;
                        player.grounded = false;
                    }
                }
            });
            document.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });


                        new THREE.RingGeometry(this.currentR, CFG.MAP * 1.4, 64),
                        ringMat
                    );
                    this.groundRing.rotation.x = -Math.PI / 2;
                    this.groundRing.position.y = 0.06;
                    scene.add(this.groundRing);

                    const wallMat = new THREE.MeshBasicMaterial({
                        color: 0x8b5cf6,
                        transparent: true,
                        opacity: 0.18,
                        side: THREE.BackSide,
                        depthWrite: false,
                    });
                    this.wallCyl = new THREE.Mesh(
                        new THREE.CylinderGeometry(this.currentR, this.currentR, 60, 64, 1, true),
                        wallMat
                    );
                    this.wallCyl.position.set(this.cx, 30, this.cz);
                    scene.add(this.wallCyl);
                },

                rebuild() {
                    if (Math.abs(this.currentR - this._lastR) < 0.4) return;
                    this._lastR = this.currentR;
                    this.groundRing.geometry.dispose();
                    this.groundRing.geometry = new THREE.RingGeometry(this.currentR, CFG.MAP * 1.4, 64);
                    this.groundRing.position.set(this.cx, 0.06, this.cz);

                    this.wallCyl.geometry.dispose();
                    this.wallCyl.geometry = new THREE.CylinderGeometry(this.currentR, this.currentR, 60, 64, 1, true);
                    this.wallCyl.position.set(this.cx, 30, this.cz);
                },

                update(dt) {
                    if (this.state === 'done') return;
                    const phases = CFG.STORM_PHASES;
                    if (this.phase >= phases.length) { this.state = 'done'; return; }
                    const ph = phases[this.phase];
                    this.phaseTimer += dt;

                    if (this.state === 'waiting') {
                        if (this.phaseTimer >= ph.wait) {
                            this.phaseTimer = 0;
                            this.state = 'shrinking';
                            this.targetR = ph.target;
                        }
                    } else {
                        const startR = this.phase === 0 ? CFG.STORM_START_R : phases[this.phase - 1].target;
                        const t = Math.min(this.phaseTimer / ph.shrink, 1);
                        this.currentR = startR + (ph.target - startR) * t;
                        if (this.phaseTimer >= ph.shrink) {
                            this.currentR = ph.target;
                            this.phaseTimer = 0;
                            this.phase++;
                            this.state = 'waiting';
                        }
                    }
                    this.rebuild();
                },

                outside(x, z) {
                    const dx = x - this.cx,
                        dz = z - this.cz;
                    return Math.sqrt(dx * dx + dz * dz) > this.currentR;
                },

                timerText() {
                    const phases = CFG.STORM_PHASES;
                    if (this.state === 'done') return 'Final zone';
                    const ph = phases[this.phase];
                    if (!ph) return '';
                    const rem = Math.ceil((this.state === 'waiting' ? ph.wait : ph.shrink) - this.phaseTimer);
                    return this.state === 'waiting' ? `Closing in ${rem}s` : `Shrinking ${rem}s`;
                }
            };

            // ============================================================
            //  SPAWN HELPERS
            // ============================================================
            function makeEnemyMesh(def) {
                const g = new THREE.Group();
                const body = new THREE.Mesh(
                    new THREE.BoxGeometry(1.1, 1.6, 1.1),
                    new THREE.MeshLambertMaterial({ color: def.bodyColor })
                );
                body.position.y = 1.1;
                body.castShadow = true;
                g.add(body);
                const head = new THREE.Mesh(
                    new THREE.BoxGeometry(0.85, 0.85, 0.85),
                    new THREE.MeshLambertMaterial({ color: def.headColor })
                );
                head.position.y = 2.35;
                head.castShadow = true;
                g.add(head);

                const hpBg = new THREE.Mesh(
                    new THREE.PlaneGeometry(1.4, 0.15),
                    new THREE.MeshBasicMaterial({ color: 0x222222, depthTest: false })
                );
                hpBg.position.set(0, 3.4, 0);
                hpBg.renderOrder = 1;
                g.add(hpBg);

                const hpFill = new THREE.Mesh(
                    new THREE.PlaneGeometry(1.4, 0.15),
                    new THREE.MeshBasicMaterial({ color: 0x22c55e, depthTest: false })
                );
                hpFill.position.set(0, 3.4, 0.01);
                hpFill.renderOrder = 2;
                g.add(hpFill);
                return { group: g, hpFill };
            }

            function spawnEnemy(type, x, z) {
                const def = ENEMY_DEF[type];
                const wave = gameState.wave;
                const wm = 1 + (wave - 1) * 0.15;
                const hp = def.hp * wm;
                const { group, hpFill } = makeEnemyMesh(def);
                group.position.set(x, 0, z);
                scene.add(group);

                enemies.push({
                    type,
                    x,
                    z,
                    radius: def.radius,
                    hp,
                    maxHp: hp,
                    spd: def.spd * (0.85 + 0.3 * Math.random()),
                    meleeDmg: def.meleeDmg * wm,
                    meleeCd: def.meleeCd,
                    meleeCooldown: 0,
                    score: def.score,
                    range: def.range,
                    fireRate: def.fireRate,
                    projDmg: def.projDmg * wm,
                    projSpd: def.projSpd,
                    lastShot: -9999,
                    angle: 0,
                    strafeDir: Math.random() < 0.5 ? 1 : -1,
                    strafeTimer: 0,
                    mesh: group,
                    hpFill,
                });
            }

            function getSpawnPos() {
                const safeR = Math.min(storm.currentR - 8, CFG.HALF - 8);
                const angle = Math.random() * Math.PI * 2;
                const d = safeR * (0.5 + 0.5 * Math.random());
                return { x: Math.cos(angle) * d, z: Math.sin(angle) * d };
            }

            function pickEnemyType(wave) {
                const r = Math.random();
                if (wave <= 2) return 'basic';
                if (wave <= 4) return r < 0.50 ? 'basic' : r < 0.82 ? 'ranged' : 'fast';
                return r < 0.28 ? 'basic' : r < 0.62 ? 'ranged' : 'fast';
            }

            // ============================================================
            //  BUILDING
            // ============================================================
            function tryBuild() {
                if (!gameState.running || gameState.paused) return;
                if (player.materials < CFG.WALL_COST) return;
                if (builtWalls.length >= CFG.MAX_WALLS) {
                    const old = builtWalls.shift();
                    scene.remove(old.mesh);
                    old.mesh.geometry.dispose();
                }
                player.materials -= CFG.WALL_COST;
                sfxBuild();

                const dist = 4.5;
                const wx = player.x + Math.cos(player.angle) * dist;
                const wz = player.z + Math.sin(player.angle) * dist;

                let mesh;
                const bt = player.buildType;
                if (bt === 0) { // Wall
                    mesh = new THREE.Mesh(
                        new THREE.BoxGeometry(4.2, 3.8, 0.4),
                        new THREE.MeshLambertMaterial({ color: 0x8B6B4A })
                    );
                    mesh.position.set(wx, 1.9, wz);
                    mesh.rotation.y = player.angle;
                } else if (bt === 1) { // Floor
                    mesh = new THREE.Mesh(
                        new THREE.BoxGeometry(4.2, 0.25, 4.2),
                        new THREE.MeshLambertMaterial({ color: 0x8B7B5A })
                    );
                    mesh.position.set(wx, 0.15, wz);
                } else { // Ramp
                    const geo = new THREE.BoxGeometry(4.2, 0.8, 4.2);
                    mesh = new THREE.Mesh(geo, new THREE.MeshLambertMaterial({ color: 0x8B7B5A }));
                    mesh.position.set(wx, 0.4, wz);
                    mesh.rotation.x = 0.4;
                    mesh.rotation.y = player.angle;
                }

                mesh.castShadow = true;
                mesh.receiveShadow = true;
                scene.add(mesh);
                builtWalls.push({ x: wx, z: wz, hp: CFG.WALL_HP, mesh });
            }

            function cycleBuildType() {
                player.buildType = (player.buildType + 1) % 3;
                const names = ['Wall', 'Floor', 'Ramp'];
                document.getElementById('buildTypeDisp').textContent = names[player.buildType];
            }

            // ============================================================
            //  SHOOTING
            // ============================================================
            function spawnPlayerBullet(angle) {
                const w = WEAPONS[player.curWeapon];
                const ws = player.weapons[player.curWeapon];
                if (player.reloading || ws.ammo <= 0) {
                    if (!player.reloading) startReload();
                    return;
                }
                const now = performance.now();
                if (now - ws.lastShot < w.delay) return;
                ws.ammo--;
                ws.lastShot = now;
                sfxShoot();

                for (let p = 0; p < w.pellets; p++) {
                    const a = angle + (Math.random() - 0.5) * w.spread;
                    const m = new THREE.Mesh(bulletGeo, pBulletMats[player.curWeapon]);
                    m.position.set(player.x, 1.4, player.z);
                    scene.add(m);
                    pBullets.push({
                        x: player.x,
                        z: player.z,
                        vx: Math.cos(a) * w.spd,
                        vz: Math.sin(a) * w.spd,
                        life: w.life,
                        dmg: w.dmg,
                        mesh: m
                    });
                }
                updateWeaponHUD();
            }

            function spawnEnemyBullet(ex, ez, angle, dmg, spd) {
                const m = new THREE.Mesh(bulletGeo, eBulletMat);
                m.position.set(ex, 1.4, ez);
                scene.add(m);
                eBullets.push({ x: ex, z: ez, vx: Math.cos(angle) * spd, vz: Math.sin(angle) * spd, life: 80, dmg, mesh: m });
            }

            function startReload() {
                const ws = player.weapons[player.curWeapon];
                if (player.reloading || ws.ammo >= WEAPONS[player.curWeapon].maxAmmo) return;
                player.reloading = true;
                player.reloadEnd = performance.now() + WEAPONS[player.curWeapon].reload;
                sfxReload();
            }

            // ============================================================
            //  INPUT

            const joyStick = document.getElementById('joyStick');

            joyZone.addEventListener('touchstart', e => {
                e.preventDefault();
                if (joy.active) return;
                const t = e.changedTouches[0];
                const r = joyZone.getBoundingClientRect();
                joy.active = true;
                joy.tid = t.identifier;
                joy.cx = r.left + r.width / 2;
                joy.cy = r.top + r.height / 2;
                joy.dx = 0;
                joy.dy = 0;
                joy.mag = 0;
                initAudio();
            }, { passive: false });

            joyZone.addEventListener('touchmove', e => {
                e.preventDefault();
                for (const t of e.changedTouches) {
                    if (t.identifier !== joy.tid) continue;
                    const rawDx = t.clientX - joy.cx;
                    const rawDy = t.clientY - joy.cy;
                    const len = Math.hypot(rawDx, rawDy) || 0.001;
                    const capped = Math.min(len, 52);
                    joy.dx = rawDx / len;
                    joy.dy = rawDy / len;
                    joy.mag = capped / 52;
                    joyStick.style.transform =
                        `translate(calc(-50% + ${joy.dx * capped}px), calc(-50% + ${joy.dy * capped}px))`;
                }
            }, { passive: false });

            joyZone.addEventListener('touchend', e => {
                e.preventDefault();
                for (const t of e.changedTouches) {
                    if (t.identifier !== joy.tid) continue;
                    joy.active = false;
                    joy.tid = null;
                    joy.dx = 0;
                    joy.dy = 0;
                    joy.mag = 0;
                    joyStick.style.transform = 'translate(-50%,-50%)';

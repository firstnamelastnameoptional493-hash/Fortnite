            // ============================================================
            //  COVER OBJECTS
            // ============================================================
            function addCover(x, z) {
                const r = Math.random();
                let geo, color;
                if (r < 0.3) {
                    geo = new THREE.DodecahedronGeometry(1.0 + Math.random() * 0.8, 0);
                    color = 0x6b7280;
                } else if (r < 0.6) {
                    const s = 1.2 + Math.random() * 1.0;
                    geo = new THREE.BoxGeometry(s, s, s);
                    color = 0x92400e;
                } else {
                    const h = 3.5 + Math.random() * 4;
                    geo = new THREE.CylinderGeometry(0.35, 0.5, h, 6);
                    color = 0x5c4a32;
                    const trunk = new THREE.Mesh(geo, new THREE.MeshLambertMaterial({ color }));
                    trunk.position.set(x, h / 2, z);
                    trunk.castShadow = true;
                    trunk.receiveShadow = true;
                    scene.add(trunk);
                    const canopy = new THREE.Mesh(
                        new THREE.ConeGeometry(2.2, 4.5, 7),
                        new THREE.MeshLambertMaterial({ color: 0x2d6a27 })
                    );
                    canopy.position.set(x, h + 2.0, z);
                    canopy.castShadow = true;
                    scene.add(canopy);
                    coverObjects.push({ x, z, r: 2.0 });
                    return;
                }
                const mesh = new THREE.Mesh(geo, new THREE.MeshLambertMaterial({ color }));
                const yOff = geo.parameters?.height ? geo.parameters.height / 2 :
                    (geo.parameters?.radius || 1.0);
                mesh.position.set(x, yOff, z);
                mesh.castShadow = true;
                mesh.receiveShadow = true;
                if (r >= 0.3 && r < 0.6) mesh.rotation.y = Math.random() * Math.PI;
                scene.add(mesh);
                coverObjects.push({ x, z, r: 1.8 });
            }

            for (let i = 0; i < 50; i++) {
                const angle = Math.random() * Math.PI * 2;
                const dist = 20 + Math.random() * 140;
                addCover(Math.cos(angle) * dist, Math.sin(angle) * dist);
            }

            // ============================================================
            //  UPDATE LOOP
            // ============================================================
            let _lastTs = null;

            function update(ts) {
                if (!gameState.running || gameState.paused) { _lastTs = null; return; }

                const dt = _lastTs !== null ? Math.min((ts - _lastTs) / 1000, 0.12) : 0.016;
                _lastTs = ts;
                gameState.gameTime += dt;

                // ── BUS ────────────────────────────────────────────────
                if (bus.active) updateBus(dt);

                // ── PLAYER MOVEMENT ───────────────────────────────────
                let mx = 0,
                    mz = 0;
                if (joy.active) {
                    mx = joy.dx;
                    mz = joy.dy;
                } else {
                    if (keys['w'] || keys['arrowup']) mz -= 1;
                    if (keys['s'] || keys['arrowdown']) mz += 1;
                    if (keys['a'] || keys['arrowleft']) mx -= 1;
                    if (keys['d'] || keys['arrowright']) mx += 1;
                }

                const movLen = Math.hypot(mx, mz);
                if (movLen > 0.01 && player.grounded) {
                    mx /= movLen;
                    mz /= movLen;
                    const sprint = (keys['shift'] || keys[' ']) ? CFG.SPRINT_MULT : 1;
                    player.x += mx * player.spd * sprint * dt;
                    player.z += mz * player.spd * sprint * dt;
                }

                // ── GLIDING ──────────────────────────────────────────
                if (player.gliding) {
                    player.glideTimer += dt;
                    if (movLen > 0.01) {
                        const gspd = CFG.GLIDE_SPEED * (0.7 + 0.3 * (1 - Math.min(player.glideTimer / 8, 1)));
                        player.x += mx * gspd * dt;
                        player.z += mz * gspd * dt;
                    }
                    player.vy -= CFG.GLIDE_FALL * dt;
                    player.y += player.vy * dt;
                    if (player.y <= 0.05) {
                        player.y = 0;
                        player.vy = 0;
                        player.gliding = false;
                        player.grounded = true;
                        if (player.gliderMesh) player.gliderMesh.visible = false;
                    }
                    if (player.gliderMesh) {
                        player.gliderMesh.rotation.z = Math.sin(performance.now() * 0.003) * 0.06;
                    }
                } else if (!player.grounded) {
                    player.vy -= 9.8 * dt;
                    player.y += player.vy * dt;
                    if (player.y <= 0) {
                        player.y = 0;
                        player.vy = 0;
                        player.grounded = true;
                        if (player.gliderMesh) player.gliderMesh.visible = false;
                    }
                }

                // ── AIM ──────────────────────────────────────────────
                if (isMobile) {
                    if (movLen > 0.01 && player.grounded) player.angle = Math.atan2(mz, mx);
                } else {
                    player.angle = Math.atan2(mouseAimZ - player.z, mouseAimX - player.x);
                }

                const margin = 3;
                player.x = Math.max(-CFG.HALF + margin, Math.min(CFG.HALF - margin, player.x));
                player.z = Math.max(-CFG.HALF + margin, Math.min(CFG.HALF - margin, player.z));

                playerGroup.position.set(player.x, player.y, player.z);
                playerGroup.rotation.y = -player.angle + Math.PI / 2;

                // ── SHOOTING ─────────────────────────────────────────
                if (WEAPONS[player.curWeapon].auto) {
                    if (isMouseDown || (isMobile && mFire)) {
                        const aimAngle = isMobile ? getMobileAimAngle() : Math.atan2(mouseAimZ - player.z, mouseAimX - player
                        .x);
                        spawnPlayerBullet(aimAngle);
                    }
                } else if (mobileShootOnce) {
                    spawnPlayerBullet(getMobileAimAngle());
                    mobileShootOnce = false;
                }

                if (player.reloading && performance.now() >= player.reloadEnd) {
                    player.weapons[player.curWeapon].ammo = WEAPONS[player.curWeapon].maxAmmo;
                    player.reloading = false;
                    updateWeaponHUD();
                }

                // ── PLAYER BULLETS ────────────────────────────────────
                for (let i = pBullets.length - 1; i >= 0; i--) {
                    const b = pBullets[i];
                    b.x += b.vx * dt;
                    b.z += b.vz * dt;
                    b.life -= dt * 60;
                    b.mesh.position.set(b.x, 1.4, b.z);

                    if (b.life <= 0 || Math.abs(b.x) > CFG.HALF || Math.abs(b.z) > CFG.HALF) {
                        killBullet(pBullets, i);
                        continue;
                    }

                    let dead = false;
                    for (let ei = enemies.length - 1; ei >= 0; ei--) {
                        const e = enemies[ei];
                        if (Math.hypot(b.x - e.x, b.z - e.z) < e.radius + 0.3) {
                            e.hp -= b.dmg;
                            player.materials = Math.min(player.materials + CFG.MAT_HIT_BONUS, CFG.MAT_MAX);
                            sfxHit();
                            updateHPBar(e);
                            if (e.hp <= 0) killEnemy(ei);
                            dead = true;
                            break;
                        }
                    }
                    if (dead) { killBullet(pBullets, i); continue; }

                    for (let wi = builtWalls.length - 1; wi >= 0; wi--) {
                        if (Math.hypot(b.x - builtWalls[wi].x, b.z - builtWalls[wi].z) < 3) {
                            builtWalls[wi].hp -= b.dmg * 0.4;
                            if (builtWalls[wi].hp <= 0) destroyWall(wi);
                            dead = true;
                            break;
                        }
                    }
                    if (dead) killBullet(pBullets, i);
                }

                // ── ENEMY BULLETS ────────────────────────────────────
                for (let i = eBullets.length - 1; i >= 0; i--) {
                    const b = eBullets[i];
                    b.x += b.vx * dt;
                    b.z += b.vz * dt;
                    b.life -= dt * 60;
                    b.mesh.position.set(b.x, 1.4, b.z);

                    if (b.life <= 0 || Math.abs(b.x) > CFG.HALF || Math.abs(b.z) > CFG.HALF) {
                        killBullet(eBullets, i);
                        continue;
                    }

                    let hit = false;
                    if (Math.hypot(b.x - player.x, b.z - player.z) < player.radius + 0.4) {
                        if (player.shield > 0) {
                            const absorb = Math.min(player.shield, b.dmg);
                            player.shield -= absorb;
                            b.dmg -= absorb;
                            if (b.dmg <= 0) { hit = true; }
                        }
                        if (b.dmg > 0) {
                            player.hp -= b.dmg;
                            sfxHit();
                        }
                        hit = true;
                    }
                    if (hit) { killBullet(eBullets, i); continue; }

                    for (let wi = builtWalls.length - 1; wi >= 0; wi--) {
                        if (Math.hypot(b.x - builtWalls[wi].x, b.z - builtWalls[wi].z) < 3) {
                            builtWalls[wi].hp -= b.dmg * 0.3;
                            if (builtWalls[wi].hp <= 0) destroyWall(wi);
                            hit = true;
                            break;
                        }
                    }
                    if (hit) killBullet(eBullets, i);
                }

                // ── ENEMY AI ──────────────────────────────────────────
                const nowMs = performance.now();
                for (let ei = enemies.length - 1; ei >= 0; ei--) {
                    const e = enemies[ei];
                    const dx = player.x - e.x;
                    const dz = player.z - e.z;
                    const dist = Math.hypot(dx, dz);
                    const angle = Math.atan2(dz, dx);
                    e.angle = angle;
                    e.strafeTimer -= dt;
                    if (e.strafeTimer <= 0) {
                        e.strafeDir = -e.strafeDir;
                        e.strafeTimer = 1.2 + Math.random() * 2;
                    }

                    if (e.type === 'ranged') {
                        const pref = e.range;
                        if (dist > pref * 1.3) {
                            e.x += Math.cos(angle) * e.spd * dt;
                            e.z += Math.sin(angle) * e.spd * dt;
                        } else if (dist < pref * 0.7) {
                            e.x -= Math.cos(angle) * e.spd * 0.5 * dt;
                            e.z -= Math.sin(angle) * e.spd * 0.5 * dt;
                        } else {
                            const sAngle = angle + Math.PI / 2 * e.strafeDir;
                            e.x += Math.cos(sAngle) * e.spd * 0.5 * dt;
                            e.z += Math.sin(sAngle) * e.spd * 0.5 * dt;
                        }
                        if (dist < e.range * 1.7 && nowMs - e.lastShot > e.fireRate) {
                            const spread = 0.07;
                            const sa = angle + (Math.random() - 0.5) * spread;
                            spawnEnemyBullet(e.x, e.z, sa, e.projDmg, e.projSpd);
                            e.lastShot = nowMs;
                        }
                    } else {
                        if (dist > 0.05) {
                            e.x += Math.cos(angle) * e.spd * dt;
                            e.z += Math.sin(angle) * e.spd * dt;
                        }
                        if (dist < e.radius + player.radius + 0.3 && e.meleeCooldown <= 0) {
                            let dmg = e.meleeDmg;
                            if (player.shield > 0) {
                                const absorb = Math.min(player.shield, dmg);
                                player.shield -= absorb;
                                dmg -= absorb;
                            }
                            if (dmg > 0) player.hp -= dmg;
                            sfxHit();
                            e.meleeCooldown = e.meleeCd;
                            if (e.type === 'fast' && dist > 0.01) {
                                e.x -= Math.cos(angle) * 5 * dt;
                                e.z -= Math.sin(angle) * 5 * dt;
                            }
                        }
                    }
                    if (e.meleeCooldown > 0) e.meleeCooldown -= dt;

                    for (const c of coverObjects) {
                        const cdx = e.x - c.x,
                            cdz = e.z - c.z;
                        const cd = Math.hypot(cdx, cdz);
                        if (cd < c.r + e.radius && cd > 0.001) {
                            e.x = c.x + (cdx / cd) * (c.r + e.radius);
                            e.z = c.z + (cdz / cd) * (c.r + e.radius);
                        }
                    }

                    e.x = Math.max(-CFG.HALF + 2, Math.min(CFG.HALF - 2, e.x));
                    e.z = Math.max(-CFG.HALF + 2, Math.min(CFG.HALF - 2, e.z));

                    e.mesh.position.set(e.x, 0, e.z);
                    e.mesh.rotation.y = -e.angle + Math.PI / 2;
                    e.mesh.children[2].lookAt(camera.position);
                    e.mesh.children[3].lookAt(camera.position);

                    if (storm.outside(e.x, e.z)) {
                        e.hp -= CFG.STORM_DAMAGE * 2.5 * dt;
                        if (e.hp <= 0) { killEnemy(ei); continue; }
                        updateHPBar(e);
                    }
                }

                // ── SPAWNING ──────────────────────────────────────────
                if (gameState.phase === 'playing') {
                    gameState.spawnTimer += dt;
                    const idx = Math.min(gameState.wave - 1, CFG.SPAWN_INTERVALS.length - 1);
                    const interval = CFG.SPAWN_INTERVALS[idx] || 2.5;
                    if (enemies.length < CFG.MAX_ENEMIES && gameState.spawnTimer >= interval) {
                        const pos = getSpawnPos();
                        spawnEnemy(pickEnemyType(gameState.wave), pos.x, pos.z);
                        gameState.spawnTimer = 0;
                    }
                }

                // ── WAVE ──────────────────────────────────────────────
                if (gameState.phase === 'playing') {
                    gameState.waveTimer += dt;
                    if (gameState.waveTimer >= CFG.WAVE_DURATION) {
                        gameState.wave++;
                        gameState.waveTimer = 0;
                    }
                }

                // ── STORM ─────────────────────────────────────────────
                storm.update(dt);
                if (storm.outside(player.x, player.z)) {
                    player.hp -= CFG.STORM_DAMAGE * dt;
                    document.getElementById('stormFlash').style.background = 'rgba(124,58,237,0.2)';
                } else {
                    document.getElementById('stormFlash').style.background = 'transparent';
                }

                // ── MATERIALS ─────────────────────────────────────────
                gameState.matTimer += dt;
                if (gameState.matTimer >= 1) {
                    player.materials = Math.min(player.materials + CFG.MAT_REGEN, CFG.MAT_MAX);
                    gameState.matTimer = 0;
                }

                // ── CHEST INTERACTION ────────────────────────────────
                if (player.grounded) {
                    for (let ci = 0; ci < chestStates.length; ci++) {
                        const cs = chestStates[ci];
                        if (cs.opened) continue;
                        const d = Math.hypot(player.x - cs.pos.x, player.z - cs.pos.z);
                        if (d < 1.8) {
                            const loot = openChest(ci);
                            if (loot) {
                                if (loot.type === 'weapon') {
                                    const wIdx = ['Pistol', 'Shotgun', 'Rifle'].indexOf(loot.name);
                                    if (wIdx >= 0) {
                                        player.curWeapon = wIdx;
                                        player.weapons[wIdx].ammo = WEAPONS[wIdx].maxAmmo;
                                        updateWeaponHUD();
                                    }
                                } else if (loot.type === 'health') {
                                    player.hp = Math.min(player.hp + loot.amount, player.maxHp);
                                } else if (loot.type === 'shield') {
                                    player.shield = Math.min(player.shield + loot.amount, player.maxShield);
                                } else if (loot.type === 'mats') {
                                    player.materials = Math.min(player.materials + loot.amount, CFG.MAT_MAX);
                                }
                                cs.mesh.children[0].material.color.setHex(0x6a6a6a);
                            }
                        }
                    }
                }

                // ── LOCATION BADGE ────────────────────────────────────
                let currentLoc = null;
                for (const loc of LOCATIONS) {
                    if (Math.hypot(player.x - loc.x, player.z - loc.z) < 35) {
                        currentLoc = loc;
                        break;
                    }
                }
                const badge = document.getElementById('locationBadge');
                if (currentLoc) {
                    badge.textContent = currentLoc.name;
                    badge.classList.add('show');
                } else {
                    badge.classList.remove('show');
                }

                // ── DEATH ─────────────────────────────────────────────
                player.hp = Math.min(player.hp, player.maxHp);
                player.shield = Math.min(player.shield, player.maxShield);
                if (player.hp <= 0) { player.hp = 0;
                    triggerGameOver(); return; }

                // ── CAMERA ────────────────────────────────────────────
                const camDist = player.gliding ? 22 : 26;
                const camHeight = player.gliding ? 20 : 24;
                camera.position.set(player.x, player.y + camHeight, player.z + camDist);
                camera.lookAt(player.x, player.y + 1, player.z);

                // ── HUD ──────────────────────────────────────────────
                updateHUD();
                drawMinimap();

                if (gameState.phase === 'bus' && player.grounded && !bus.active) {
                    gameState.phase = 'playing';
                    document.getElementById('busPrompt').style.display = 'none';
                }
            }

            // ============================================================
            //  HELPERS
            // ============================================================
            function getMobileAimAngle() {
                let bestDist = Infinity,
                    bestAngle = player.angle;
                for (const e of enemies) {
                    const d = Math.hypot(e.x - player.x, e.z - player.z);
                    if (d < bestDist) { bestDist = d;
                        bestAngle = Math.atan2(e.z - player.z, e.x - player.x); }
                }
                return bestAngle;
            }

            function updateHPBar(e) {
                const pct = Math.max(0, e.hp / e.maxHp);
                e.hpFill.scale.x = pct;
                e.hpFill.position.x = -0.7 * (1 - pct);
            }

            function killEnemy(idx) {
                const e = enemies[idx];
                gameState.score += e.score;
                player.materials = Math.min(player.materials + CFG.MAT_KILL_BONUS, CFG.MAT_MAX);
                scene.remove(e.mesh);
                enemies.splice(idx, 1);
            }

            function destroyWall(idx) {
                const w = builtWalls[idx];
                scene.remove(w.mesh);
                w.mesh.geometry.dispose();
                builtWalls.splice(idx, 1);
            }

            function killBullet(arr, i) {
                scene.remove(arr[i].mesh);
                arr.splice(i, 1);
            }

            // ============================================================
            //  HUD
            // ============================================================
            function updateHUD() {
                const hpPct = Math.max(0, player.hp / player.maxHp * 100);
                document.getElementById('hpVal').textContent = Math.ceil(player.hp);
                document.getElementById('healthFill').style.width = hpPct + '%';
                document.getElementById('healthFill').style.background =
                    hpPct > 50 ? 'linear-gradient(90deg,#22c55e,#4ade80)' :
                    hpPct > 25 ? 'linear-gradient(90deg,#f59e0b,#fbbf24)' :
                    'linear-gradient(90deg,#ef4444,#f87171)';

                const shPct = Math.max(0, player.shield / player.maxShield * 100);
                document.getElementById('shieldVal').textContent = Math.ceil(player.shield);
                document.getElementById('shieldFill').style.width = shPct + '%';

                document.getElementById('scoreVal').textContent = gameState.score;
                document.getElementById('matsVal').textContent = player.materials;
                document.getElementById('waveVal').textContent = gameState.wave;
                const wRem = Math.ceil(CFG.WAVE_DURATION - gameState.waveTimer);
                document.getElementById('nextWaveVal').textContent = `Next: ${wRem}s`;
                document.getElementById('aliveVal').textContent = `👾 ${enemies.length}`;

                const sb = document.getElementById('stormBadge');
                sb.style.display = 'block';
                document.getElementById('stormTxt').textContent = storm.timerText();
            }

            function updateWeaponHUD() {
                const w = WEAPONS[player.curWeapon];
                const ws = player.weapons[player.curWeapon];
                document.getElementById('weaponName').textContent = w.name;
                document.getElementById('ammoDisp').textContent = `${ws.ammo} / ${w.maxAmmo}`;
                document.getElementById('reloadDisp').textContent =
                    player.reloading ? 'Reloading…' : ws.ammo === 0 ? 'EMPTY — R' : 'Ready';
                const names = ['Wall', 'Floor', 'Ramp'];
                document.getElementById('buildTypeDisp').textContent = names[player.buildType];
            }

            // ============================================================
            //  MINIMAP
            // ============================================================
            const mmCtx = document.getElementById('mmCanvas').getContext('2d');
            const MM = 85;

            function drawMinimap() {
                mmCtx.clearRect(0, 0, MM, MM);
                mmCtx.save();
                mmCtx.beginPath();
                mmCtx.arc(MM / 2, MM / 2, MM / 2, 0, Math.PI * 2);
                mmCtx.clip();

                const scale = MM / CFG.MAP;
                mmCtx.fillStyle = 'rgba(10,18,10,0.85)';
                mmCtx.fillRect(0, 0, MM, MM);

                for (const loc of LOCATIONS) {
                    const lx = MM / 2 + loc.x * scale;
                    const lz = MM / 2 + loc.z * scale;
                    mmCtx.fillStyle = '#4a7a4a';
                    mmCtx.beginPath();
                    mmCtx.arc(lx, lz, 3, 0, Math.PI * 2);
                    mmCtx.fill();
                    mmCtx.fillStyle = 'rgba(255,255,255,0.3)';
                    mmCtx.font = '5px sans-serif';
                    mmCtx.fillText(loc.name.substring(0, 4), lx - 6, lz - 5);
                }

                const sr = storm.currentR * scale;
                mmCtx.beginPath();
                mmCtx.arc(MM / 2 + storm.cx * scale, MM / 2 + storm.cz * scale, sr, 0, Math.PI * 2);
                mmCtx.strokeStyle = 'rgba(168,85,247,0.9)';
                mmCtx.lineWidth = 1.5;
                mmCtx.stroke();
                mmCtx.save();
                mmCtx.beginPath();
                mmCtx.rect(0, 0, MM, MM);
                mmCtx.arc(MM / 2 + storm.cx * scale, MM / 2 + storm.cz * scale, sr, 0, Math.PI * 2);
                mmCtx.fillStyle = 'rgba(124,58,237,0.2)';
                mmCtx.fill('evenodd');
                mmCtx.restore();

                for (const cs of chestStates) {
                    if (cs.opened) continue;
                    const cx2 = MM / 2 + cs.pos.x * scale;
                    const cz2 = MM / 2 + cs.pos.z * scale;
                    mmCtx.fillStyle = '#fbbf24';
                    mmCtx.beginPath();
                    mmCtx.arc(cx2, cz2, 1.5, 0, Math.PI * 2);
                    mmCtx.fill();
                }

                for (const e of enemies) {
                    const ex = MM / 2 + e.x * scale;
                    const ez = MM / 2 + e.z * scale;
                    const col = e.type === 'ranged' ? '#a78bfa' : e.type === 'fast' ? '#fb923c' : '#f87171';
                    mmCtx.fillStyle = col;
                    mmCtx.beginPath();
                    mmCtx.arc(ex, ez, 2.2, 0, Math.PI * 2);
                    mmCtx.fill();
                }

                const px = MM / 2 + player.x * scale;
                const pz = MM / 2 + player.z * scale;
                mmCtx.fillStyle = '#3b82f6';
                mmCtx.beginPath();
                mmCtx.arc(px, pz, 3.5, 0, Math.PI * 2);
                mmCtx.fill();
                mmCtx.fillStyle = '#eff6ff';
                mmCtx.beginPath();
                mmCtx.arc(px, pz, 1.8, 0, Math.PI * 2);
                mmCtx.fill();

                mmCtx.restore();
            }

            // ============================================================
            //  INIT GAME
            // ============================================================
            function initGame() {
                for (const e of enemies) scene.remove(e.mesh);
                for (const b of pBullets) scene.remove(b.mesh);
                for (const b of eBullets) scene.remove(b.mesh);
                for (const w of builtWalls) { scene.remove(w.mesh);
                    w.mesh.geometry.dispose(); }
                enemies.length = pBullets.length = eBullets.length = builtWalls.length = 0;

                for (const cs of chestStates) {
                    scene.remove(cs.mesh);
                }
                chestStates.length = 0;

                player.x = 0;
                player.z = 0;
                player.y = 0;
                player.vy = 0;
                player.angle = 0;
                player.hp = CFG.PLAYER_HP;
                player.maxHp = CFG.PLAYER_HP;
                player.shield = 0;
                player.maxShield = 100;
                player.materials = CFG.MAT_START;
                player.grounded = true;
                player.gliding = false;
                player.glideTimer = 0;
                player.spd = CFG.PLAYER_SPEED;
                player.weapons = WEAPONS.map(w => ({ ammo: w.maxAmmo, lastShot: -9999 }));
                player.curWeapon = 0;
                player.reloading = false;
                player.buildType = 0;
                if (player.gliderMesh) { player.gliderMesh.visible = false; }

                storm.currentR = CFG.STORM_START_R;
                storm.targetR = CFG.STORM_START_R;
                storm.phase = 0;
                storm.phaseTimer = 0;
                storm.state = 'waiting';
                storm._lastR = -1;
                storm.rebuild();

                Object.assign(gameState, {
                    running: true,
                    paused: false,
                    wave: 1,
                    waveTimer: 0,
                    spawnTimer: 0,
                    matTimer: 0,
                    score: 0,
                    gameTime: 0,
                    phase: 'bus'
                });
                _lastTs = null;

                buildLocations();

                if (bus.mesh) { scene.remove(bus.mesh);
                    bus.mesh = null; }
                initBattleBus();

                document.getElementById('gameOver').style.display = 'none';
                document.getElementById('pauseOverlay').style.display = 'none';
                document.getElementById('busPrompt').style.display = 'block';
                updateWeaponHUD();

                player.x = bus.x;
                player.z = bus.z;
                player.y = bus.y - 2;
                player.grounded = false;
                player.vy = -0.5;
            }

            // ============================================================
            //  MENU FUNCTIONS
            // ============================================================
            function startGame() {
                document.getElementById('startMenu').style.display = 'none';
                initGame();
            }

            function restartGame() {
                initGame();
            }

            function triggerGameOver() {
                gameState.running = false;
                gameState.phase = 'over';
                document.getElementById('finalScore').textContent = gameState.score;
                document.getElementById('gameOver').style.display = 'flex';
            }

            function returnToMenu() {
                gameState.running = false;
                gameState.paused = false;
                document.getElementById('gameOver').style.display = 'none';
                document.getElementById('pauseOverlay').style.display = 'none';
                document.getElementById('startMenu').style.display = 'flex';
                document.getElementById('busPrompt').style.display = 'none';
                _lastTs = null;
                if (bus.mesh) { scene.remove(bus.mesh);
                    bus.mesh = null;
                    bus.active = false; }
            }

            function togglePause() {
                if (!gameState.running) return;
                gameState.paused = !gameState.paused;
                document.getElementById('pauseOverlay').style.display = gameState.paused ? 'flex' : 'none';
                if (gameState.paused) _lastTs = null;
            }

            function openControls() {
                document.getElementById('startMenu').style.display = 'none';
                document.getElementById('controlsModal').style.display = 'flex';
            }

            function closeControls() {
                document.getElementById('controlsModal').style.display = 'none';
                document.getElementById('startMenu').style.display = 'flex';
            }

            // ============================================================
            //  RENDER LOOP
            // ============================================================
            function renderLoop(ts) {
                requestAnimationFrame(renderLoop);
                update(ts);
                if (player.reloading) updateWeaponHUD();
                renderer.render(scene, camera);
            }

            // ============================================================
            //  BOOT
            // ============================================================
            CFG.SPAWN_INTERVALS = [4.5, 3.8, 3.0, 2.4, 1.8, 1.4];

            storm.init();
            updateWeaponHUD();
            renderLoop(0);

            // Expose menu functions globally
            window.startGame = startGame;
            window.restartGame = restartGame;
            window.returnToMenu = returnToMenu;
            window.togglePause = togglePause;
            window.openControls = openControls;
            window.closeControls = closeControls;

            console.log('⚡ Fortnite 3D Battle Royale loaded successfully!');
        }
    </script>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title>Fortnite 3D Battle Royale</title>
    <style>
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #0a0e1a;
            overflow: hidden;
            font-family: 'Segoe UI', system-ui, sans-serif;
            user-select: none;
            -webkit-user-select: none;
            touch-action: none;
            position: fixed;
            width: 100%;
            height: 100%;
        }
        canvas {
            position: fixed !important;
            top: 0;
            left: 0;
            width: 100vw !important;
            height: 100vh !important;
            z-index: 0;
        }

        /* HUD */
        #hud {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 5;
        }
        .hud-panel {
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            padding: 8px 12px;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.5;
            letter-spacing: 0.3px;
        }
        #hudTL {
            position: absolute;
            top: 10px;
            left: 10px;
            min-width: 140px;
        }
        #healthBar {
            width: 100%;
            height: 5px;
            background: rgba(0, 0, 0, 0.5);
            border-radius: 3px;
            overflow: hidden;
            margin-top: 3px;
        }
        #healthFill {
            height: 100%;
            width: 100%;
            border-radius: 3px;
            transition: width .12s;
        }
        #shieldBar {
            width: 100%;
            height: 4px;
            background: rgba(0, 0, 0, 0.4);
            border-radius: 2px;
            overflow: hidden;
            margin-top: 2px;
        }
        #shieldFill {
            height: 100%;
            width: 0%;
            border-radius: 2px;
            background: #38bdf8;
            transition: width .12s;
        }
        #hudTR {
            position: absolute;
            top: 10px;
            right: 10px;
            text-align: right;
            color: #fcd34d;
            font-size: 12px;
        }
        #hudTR span {
            color: #cbd5e1;
            font-weight: 400;
            display: block;
            font-size: 11px;
        }
        #weaponHUD {
            position: absolute;
            bottom: 150px;
            right: 10px;
            text-align: right;
            min-width: 100px;
        }
        #weaponHUD.mobile-shifted {
            bottom: 14px;
            right: 180px;
        }
        #weaponName {
            color: #fde047;
            font-weight: 700;
            font-size: 15px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        #ammoDisp {
            font-size: 12px;
            color: #e2e8f0;
        }
        #reloadDisp {
            font-size: 11px;
            color: #fcd34d;
        }

        #locationBadge {
            position: absolute;
            top: 70px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: #fff;
            font-size: 16px;
            font-weight: 700;
            padding: 4px 18px;
            letter-spacing: 1px;
            text-transform: uppercase;
            opacity: 0;
            transition: opacity .4s;
            pointer-events: none;
        }
        #locationBadge.show {
            opacity: 1;
        }

        #stormBadge {
            position: absolute;
            bottom: 150px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(124, 58, 237, 0.7);
            border: 1px solid rgba(167, 139, 250, 0.5);
            border-radius: 8px;
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            padding: 4px 14px;
            white-space: nowrap;
            display: none;
        }
        #stormBadge.mobile-shifted {
            bottom: 14px;
        }

        #busPrompt {
            position: absolute;
            bottom: 40%;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            border: 2px solid rgba(255, 215, 0, 0.4);
            border-radius: 14px;
            color: #fff;
            padding: 16px 32px;
            text-align: center;
            pointer-events: none;
            z-index: 6;
            display: none;
        }
        #busPrompt h2 {
            font-size: 22px;
            color: #fcd34d;
            margin-bottom: 4px;
        }
        #busPrompt p {
            font-size: 14px;
            color: #94a3b8;
        }
        #busPrompt .key-hint {
            display: inline-block;
            background: rgba(255, 255, 255, 0.15);
            padding: 2px 12px;
            border-radius: 6px;
            font-weight: 700;
            color: #fcd34d;
            margin: 0 4px;
        }

        /* Minimap */
        #minimap {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 85px;
            height: 85px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
            background: rgba(0, 0, 0, 0.4);
        }
        #mmCanvas {
            display: block;
            width: 100%;
            height: 100%;
        }

        #stormFlash {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 4;
            transition: background .3s;
            background: transparent;
        }

        /* Mobile Controls */
        #mobileControls {
            display: none;
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 140px;
            z-index: 10;
            pointer-events: none;
        }
        #joystickZone {
            position: absolute;
            bottom: 10px;
            left: 10px;
            width: 120px;
            height: 120px;
            pointer-events: all;
            touch-action: none;
        }
        #joyBase {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            border: 2px solid rgba(255, 255, 255, 0.2);
        }
        #joyStick {
            position: absolute;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            border: 2px solid rgba(255, 255, 255, 0.5);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            transition: none;
        }

        .ctrl-btn {
            position: absolute;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            pointer-events: all;
            touch-action: none;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
            border: none;
            outline: none;
            color: #fff;
        }
        #fireBtn {
            bottom: 16px;
            right: 16px;
            width: 80px;
            height: 80px;
            background: rgba(239, 68, 68, 0.8);
            border: 3px solid rgba(248, 113, 113, 0.8);
            box-shadow: 0 4px 30px rgba(239, 68, 68, 0.3);
            font-size: 30px;
        }
        #buildBtn {
            bottom: 18px;
            right: 112px;
            width: 60px;
            height: 60px;
            background: rgba(34, 197, 94, 0.75);
            border: 2px solid rgba(74, 222, 128, 0.8);
            box-shadow: 0 4px 20px rgba(34, 197, 94, 0.25);
            font-size: 22px;
        }
        #jumpBtn {
            bottom: 90px;
            right: 16px;
            width: 56px;
            height: 56px;
            background: rgba(59, 130, 246, 0.7);
            border: 2px solid rgba(96, 165, 250, 0.7);
            font-size: 18px;
            box-shadow: 0 4px 20px rgba(59, 130, 246, 0.2);
        }
        #fireBtn.active {
            background: rgba(239, 68, 68, 1);
            transform: scale(0.92);
        }
        #buildBtn.active {
            background: rgba(34, 197, 94, 1);
            transform: scale(0.92);
        }
        #jumpBtn.active {
            background: rgba(59, 130, 246, 1);
            transform: scale(0.92);
        }

        #pauseBtn {
            display: none;
            position: fixed;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            z-index: 11;
            align-items: center;
            justify-content: center;
            pointer-events: all;
            -webkit-tap-highlight-color: transparent;
            backdrop-filter: blur(4px);
        }

        /* Overlays */
        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(10, 15, 30, 0.92);
            backdrop-filter: blur(12px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 100;
            color: #fff;
            text-align: center;
            padding: 24px;
        }
        .overlay h1 {
            font-size: clamp(28px, 7vw, 52px);
            background: linear-gradient(135deg, #f97316, #eab308);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-bottom: 6px;
        }
        .overlay .subtitle {
            color: #94a3b8;
            font-size: 15px;
            max-width: 400px;
            line-height: 1.6;
            margin-bottom: 18px;
            -webkit-text-fill-color: #94a3b8;
        }
        .menu-btn {
            font-size: 17px;
            font-weight: 700;
            padding: 13px 38px;
            margin: 6px 0;
            background: linear-gradient(135deg, #f97316, #ea580c);
            color: #fff;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(249, 115, 22, 0.35);
            transition: transform .15s, box-shadow .15s;
            width: min(260px, 82vw);
            -webkit-tap-highlight-color: transparent;
        }
        .menu-btn:hover,
        .menu-btn:active {
            transform: translateY(-2px);
            box-shadow: 0 6px 30px rgba(249, 115, 22, 0.5);
        }
        .menu-btn.sec {
            background: rgba(255, 255, 255, 0.07);
            box-shadow: none;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        .menu-btn.sec:hover {
            background: rgba(255, 255, 255, 0.12);
        }

        #pauseOverlay {
            background: rgba(10, 15, 30, 0.85);
        }
        #pauseOverlay h2 {
            font-size: clamp(32px, 8vw, 56px);
            background: linear-gradient(90deg, #60a5fa, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
            letter-spacing: 4px;
            margin-bottom: 8px;
        }

        .ctrl-tbl {
            border-collapse: collapse;
            font-size: 13px;
            margin-bottom: 18px;
            width: 300px;
            max-width: 92vw;
        }
        .ctrl-tbl th {
            color: #fde047;
            text-align: left;
            padding: 4px 10px;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .ctrl-tbl td {
            padding: 4px 10px;
            color: #e2e8f0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }
        .ctrl-tbl td:first-child {
            color: #7dd3fc;
            font-family: monospace;
            font-weight: 700;
        }
        .ctrl-tbl tr:last-child td {
            border-bottom: none;
        }

        #noThree {
            position: fixed;
            inset: 0;
            z-index: 999;
            background: #0f172a;
            color: #fff;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
            font-size: 17px;
            text-align: center;
            padding: 24px;
        }

        @media(max-width:600px) {
            .hud-panel {
                font-size: 11px;
                padding: 5px 9px;
                border-radius: 8px;
            }
            #hudTL {
                min-width: 100px;
                top: 6px;
                left: 6px;
            }
            #hudTR {
                top: 6px;
                right: 6px;
                font-size: 10px;
            }
            #minimap {
                width: 60px;
                height: 60px;
                top: 6px;
            }
            #weaponHUD {
                bottom: 130px;
                right: 6px;
                min-width: 70px;
                padding: 4px 8px;
            }
            #weaponName {
                font-size: 12px;
            }
            #stormBadge {
                font-size: 10px;
                padding: 3px 10px;
                bottom: 130px;
            }
            #busPrompt {
                padding: 12px 20px;
                bottom: 35%;
            }
            #busPrompt h2 {
                font-size: 18px;
            }
            #busPrompt p {
                font-size: 12px;
            }
            .ctrl-btn {
                transform: scale(0.85);
            }
            #fireBtn {
                width: 68px;
                height: 68px;
                right: 8px;
                bottom: 10px;
                font-size: 24px;
            }
            #buildBtn {
                width: 52px;
                height: 52px;
                right: 88px;
                bottom: 12px;
                font-size: 18px;
            }
            #jumpBtn {
                width: 48px;
                height: 48px;
                right: 8px;
                bottom: 82px;
                font-size: 14px;
            }
            #joystickZone {
                width: 90px;
                height: 90px;
                bottom: 8px;
                left: 6px;
            }
            #joyStick {
                width: 38px;
                height: 38px;
            }
            #pauseBtn {
                width: 36px;
                height: 36px;
                font-size: 14px;
                top: 6px;
            }
            #locationBadge {
                font-size: 13px;
                top: 58px;
                padding: 2px 14px;
            }
        }

        /* Loading spinner */
        #loadingOverlay {
            position: fixed;
            inset: 0;
            background: #0a0e1a;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 200;
            color: #fff;
            font-size: 18px;
            gap: 16px;
        }
        .spinner {
            width: 50px;
            height: 50px;
            border: 5px solid rgba(255, 255, 255, 0.1);
            border-top-color: #f97316;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>

    <!-- Loading overlay -->
    <div id="loadingOverlay">
        <div class="spinner"></div>
        <div>Loading Fortnite 3D...</div>
    </div>

    <!-- Fallback if all CDNs fail -->
    <div id="noThree">
        <div style="font-size:48px">⚠️</div>
        <strong>Could not load Three.js</strong>
        <p style="color:#94a3b8;font-size:14px;max-width:340px">All CDN attempts failed. Check your internet connection and reload.</p>
        <button class="menu-btn" onclick="location.reload()">Reload</button>
    </div>

    <!-- HUD -->
    <div id="hud">
        <div id="hudTL" class="hud-panel">
            ❤️ <span id="hpVal">100</span>
            <div id="healthBar"><div id="healthFill"></div></div>
            🛡️ <span id="shieldVal">0</span>
            <div id="shieldBar"><div id="shieldFill"></div></div>
            🏆 <span id="scoreVal">0</span> &nbsp; 📦 <span id="matsVal">100</span>
        </div>

        <div id="minimap"><canvas id="mmCanvas" width="85" height="85"></canvas></div>

        <div id="hudTR" class="hud-panel">
            Wave <span id="waveVal">1</span>
            <span id="nextWaveVal">Next: 30s</span>
            <span id="aliveVal">👾 0</span>
        </div>

        <div id="locationBadge">Pleasant Park</div>
        <div id="stormBadge">⚡ STORM — <span id="stormTxt">Waiting</span></div>

        <div id="weaponHUD" class="hud-panel">
            <div id="weaponName">Pistol</div>
            <div id="ammoDisp">12 / 12</div>
            <div id="reloadDisp">Ready</div>
            <div id="buildTypeDisp" style="font-size:10px;color:#94a3b8;margin-top:2px;">Wall</div>
        </div>

        <div id="busPrompt">
            <h2>🚌 BATTLE BUS</h2>
            <p>Press <span class="key-hint">SPACE</span> or tap <span class="key-hint">⬆</span> to jump &amp; glide</p>
            <p style="font-size:12px;color:#64748b;margin-top:4px;">Choose your landing spot!</p>
        </div>
    </div>

    <div id="stormFlash"></div>

    <button id="pauseBtn" onclick="togglePause()">⏸</button>

    <div id="mobileControls">
        <div id="joystickZone">
            <div id="joyBase"></div>
            <div id="joyStick"></div>
        </div>
        <div id="jumpBtn" class="ctrl-btn">⬆</div>
        <div id="buildBtn" class="ctrl-btn">🧱</div>
        <div id="fireBtn" class="ctrl-btn">🔫</div>
    </div>

    <!-- Menus -->
    <div id="startMenu" class="overlay">
        <h1>⚡ Battle Royale</h1>
        <div class="subtitle">Drop in, loot up, build, and survive the storm. Last one standing wins!</div>
        <button class="menu-btn" onclick="startGame()">▶ Play</button>
        <button class="menu-btn sec" onclick="openControls()">Controls</button>
    </div>

    <div id="gameOver" class="overlay" style="display:none">
        <h1>💀 Eliminated</h1>
        <div class="subtitle">You were taken out of the arena.</div>
        <p style="font-size:22px;color:#fde047;margin:0 0 16px">Score: <strong id="finalScore">0</strong></p>
        <button class="menu-btn" onclick="restartGame()">Try Again</button>
        <button class="menu-btn sec" onclick="returnToMenu()">Main Menu</button>
    </div>

    <div id="pauseOverlay" class="overlay" style="display:none">
        <h2>⏸ Paused</h2>
        <div class="subtitle">Game is paused</div>
        <button class="menu-btn" onclick="togglePause()">▶ Resume</button>
        <button class="menu-btn sec" onclick="returnToMenu()">Main Menu</button>
    </div>

    <div id="controlsModal" class="overlay" style="display:none">
        <h1>🎮 Controls</h1>
        <table class="ctrl-tbl">
            <thead><tr><th>Input</th><th>Action</th></tr></thead>
            <tbody>
                <tr><td>WASD / Arrows</td><td>Move</td></tr>
                <tr><td>Mouse</td><td>Aim (desktop)</td></tr>
                <tr><td>Click / Hold</td><td>Fire</td></tr>
                <tr><td>Space</td><td>Jump / Glide</td></tr>
                <tr><td>1 / 2 / 3</td><td>Switch weapon</td></tr>
                <tr><td>R</td><td>Reload</td></tr>
                <tr><td>F / Q</td><td>Build / Cycle type</td></tr>
                <tr><td>P / Esc</td><td>Pause</td></tr>
                <tr><td>Joystick</td><td>Move (mobile)</td></tr>
                <tr><td>🔫 Button</td><td>Fire (mobile)</td></tr>
                <tr><td>🧱 Button</td><td>Build (mobile)</td></tr>
                <tr><td>⬆ Button</td><td>Jump/Glide (mobile)</td></tr>
            </tbody>
        </table>
        <button class="menu-btn sec" onclick="closeControls()">Back</button>
    </div>

    <script>
        // ============================================================
        //  THREE.JS LOADER WITH FALLBACK
        // ============================================================
        (function loadThree() {
            const cdnList = [
                'https://cdn.jsdelivr.net/npm/three@0.164.1/build/three.min.js',
                'https://unpkg.com/three@0.164.1/build/three.min.js',
                'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js'
            ];
            let index = 0;
            const loadingEl = document.getElementById('loadingOverlay');
            const errorEl = document.getElementById('noThree');

            function tryLoad() {
                if (index >= cdnList.length) {
                    // All failed
                    loadingEl.style.display = 'none';
                    errorEl.style.display = 'flex';
                    return;
                }
                const script = document.createElement('script');
                script.src = cdnList[index];
                script.onload = function() {
                    if (typeof THREE !== 'undefined') {
                        // Success
                        loadingEl.style.display = 'none';
                        // Now start the app
                        startApp();
                    } else {
                        // loaded but THREE not defined? try next
                        index++;
                        tryLoad();
                    }
                };
                script.onerror = function() {
                    // Failed to load this CDN
                    index++;
                    tryLoad();
                };
                document.head.appendChild(script);
            }

            // Start loading
            tryLoad();
        })();

        // ============================================================
        //  MAIN APPLICATION — runs after THREE is loaded
        // ============================================================
        function startApp() {
            // All the game code goes here, using THREE global
            // ============================================================
            //  CONFIG
            // ============================================================
            const CFG = {
                MAP: 400,
                HALF: 200,
                PLAYER_SPEED: 10,
                SPRINT_MULT: 1.6,
                PLAYER_HP: 100,
                PLAYER_RADIUS: 1.1,
                MAT_START: 100,
                MAT_MAX: 300,
                MAT_REGEN: 1.2,
                MAT_HIT_BONUS: 2,
                MAT_KILL_BONUS: 6,
                WALL_COST: 20,
                WALL_HP: 80,
                MAX_WALLS: 16,
                WAVE_DURATION: 32,
                MAX_ENEMIES: 25,
                STORM_DAMAGE: 3,
                STORM_START_R: 170,
                STORM_PHASES: [
                    { wait: 25, shrink: 20, target: 120 },
                    { wait: 22, shrink: 18, target: 80 },
                    { wait: 18, shrink: 16, target: 50 },
                    { wait: 15, shrink: 13, target: 28 },
